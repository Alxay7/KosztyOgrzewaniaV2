<Window x:Class="KosztyOgrzewania.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KosztyOgrzewania"
        mc:Ignorable="d"
        Title="Koszty ogrzewania" Height="520" Width="560"
        MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dane użytkownika -->
        <GroupBox Grid.Row="0" Header="Dane o obecnym ogrzewaniu" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Wydatki na ogrzewanie w ciągu roku:"
                           VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="WydatkiNaOgrzewanieTextBox" Grid.Row="0" Grid.Column="1"
                         Margin="0,0,5,8"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="zł"
                           VerticalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Użyty surowiec:"
                           VerticalAlignment="Center" Margin="0,0,10,8"/>
                <ComboBox x:Name="UzytySurowiecComboBox" Grid.Row="1" Grid.Column="1"
                          Grid.ColumnSpan="2" Margin="0,0,0,8" SelectionChanged="UzytySurowiecComboBox_SelectionChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ilość zużytego surowca:"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="IloscZuzytegoSurowcaTextBox" Grid.Row="2" Grid.Column="1"
                         Margin="0,0,5,0"/>
                <TextBlock x:Name="JednostkaTextBlock" Grid.Row="2" Grid.Column="2" Text="kg/m³" Margin="0,1,0,1"/>
            </Grid>
        </GroupBox>

        <!-- Straty energii -->
        <GroupBox Grid.Row="1" Header="Straty energii" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <Slider x:Name="PoziomStratSlider" Grid.Column="0"
                        Minimum="-10" Maximum="100" Value="0"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding Value, ElementName=PoziomStratSlider, StringFormat={}{0:0} %}"/>
            </Grid>
        </GroupBox>

        <!-- Surowiec porównawczy -->
        <GroupBox Grid.Row="2" Header="Porównanie" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Surowiec porównawczy:"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="SurowiecPorownawczyComboBox" Grid.Column="1" SelectionChanged="SurowiecPorownawczyComboBox_SelectionChanged"/>
            </Grid>
        </GroupBox>

        <!-- Przycisk i wyniki -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="ObliczButton" DockPanel.Dock="Top" Content="Oblicz"
                    HorizontalAlignment="Right" Padding="20,5" Margin="0,0,0,10" Click="ObliczButton_Click"/>

            <GroupBox Header="Wyniki" Padding="10">
                <StackPanel>
                    <TextBlock x:Name="WynikEnergiaTextBlock" Margin="0,0,0,5"/>
                    <TextBlock x:Name="WynikEnergiaZeStratamiTextBlock" Margin="0,0,0,5"/>
                    <TextBlock x:Name="WynikIloscSurowcaPorownawczegoTextBlock" Margin="0,0,0,5"/>
                    <TextBlock x:Name="WynikKosztSurowcaPorownawczegoTextBlock"/>
                </StackPanel>
            </GroupBox>
        </DockPanel>
    </Grid>
</Window>